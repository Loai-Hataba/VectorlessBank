# Claude Code local state: worktrees and session scratch. Machine-local,
# never meant to be shared.
.claude/

# Python bytecode.
#
# NOTE: .pyc files were already tracked in this repo before this file
# existed, and .gitignore does NOT untrack what git already tracks, so
# those keep showing as modified whenever the matching .py changes.
# They are also built per interpreter version (cpython-310 vs
# cpython-313), so two developers on different Python versions will
# fight over them. To stop both problems:
#
#     git rm -r --cached "Phase 1/**/__pycache__"
#
# (removes them from git history going forward, leaves them on disk).
__pycache__/
*.py[cod]

# Virtual environments
.venv/
venv/
env/

# OS / editor cruft
.DS_Store
Thumbs.db
.idea/

# Tier 2 evaluation run artifacts.
#
# generated_answers.json is the cached output of a ~2 hour pipeline run.
# It is reproducible, differs on every run, and would otherwise show as
# a large diff every time anyone evaluates anything. The scripts that
# produce and consume it are tracked; the results are not.
Phase 1/evaluation/generated_answers.json
Phase 1/evaluation/tier2_scores.json

# The separate environment Tier 2 installs into (see
# Phase 1/evaluation/requirements-eval.txt).
.venv-eval/
